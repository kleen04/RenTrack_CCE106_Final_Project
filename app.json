{
  "expo": {
    "name": "RentTrack_Vehicle_Rental_Management",
    "slug": "RentTrack_Vehicle_Rental_Management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RentTrack to choose vehicle photos from your gallery."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RentTrack to access the camera to scan vehicle QR codes.",
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
